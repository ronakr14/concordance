# Copy to .env and edit. .env is never committed.
# Values below are safe placeholders, not secrets.

# --- active from Stage 0 ---------------------------------------------------
ENV=development                      # development | test | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
DATA_DIR=data
REPORTS_DIR=reports
STORAGE_BACKEND=local                # local | s3
STORAGE_LOCAL_PATH=data/storage
MAX_CANDIDATES_PER_RECORD=50
TARGET_PRECISION=0.99
RANDOM_SEED=20260914

# --- Stage 4: LLM ----------------------------------------------------------
LLM_ENABLED=false                    # false runs the whole pipeline with no LLM
LLM_PROVIDER_CHAIN=groq,openrouter   # ordered fallback chain
LLM_MODEL=                           # blank = each provider keeps its own default
# Per-provider, because the two vendors share no model vocabulary.
GROQ_MODEL=openai/gpt-oss-20b        # blank = provider default
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
GROQ_API_KEY=changeme
OPENROUTER_API_KEY=changeme
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3                   # attempts per provider before failover
LLM_TOP_K=3                          # candidates shown to the adjudicator
LLM_CACHE_DIR=                       # blank = .cache/llm/
LLM_PRICE_TABLE=                     # blank = the built-in price table
LAB_PRICE_MODEL=meta-llama/llama-3.3-70b-instruct  # reference price for the Lab cost panel
LAB_SWEEP_WORKERS=4                  # sweep levels in parallel; each holds a 50k-provider index

# --- Stage 5: Postgres -----------------------------------------------------
# The owning role: it runs migrations and owns the tables. Note the `+psycopg`
# driver suffix, which SQLAlchemy needs and a provider's copy button omits.
DATABASE_URL=postgresql+psycopg://concordance:changeme@localhost:5432/concordance
# The least-privilege role the application connects as. It must not be the
# owner: a table's owner keeps every privilege on its own table, so the revoke
# that makes `audit_logs` append-only cannot be tested - or enforced - against
# it. The migration grants this role data privileges and no DDL.
APP_DATABASE_URL=postgresql+psycopg://concordance_app:changeme@localhost:5432/concordance
# Against a hosted database add `?sslmode=require`, and raise
# DB_CONNECT_TIMEOUT below: a provider that suspends an idle compute needs
# longer than a local socket to answer the first connection.

# --- Stage 7: API and workflow --------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
DEFAULT_CASE_MONTHS=3
# Origins the browser may call the API from. The Vite dev server by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Sanction upload limits: bytes per file, data rows per file.
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_ROWS=100000
DB_CONNECT_TIMEOUT=5
# Server-side ceiling on one statement, in seconds; 0 disables it. Raise it for
# a slow link, lower it if you would rather a run failed than hung.
DB_STATEMENT_TIMEOUT=180
# Rows per INSERT statement. Lower it on a slow or inspected link, raise it on
# a local database where round trips are free.
DB_INSERT_PAGE_SIZE=50

# --- Stage 8: web app -----------------------------------------------------
# The browser reaches the API through an /api prefix (the Vite proxy in dev,
# nginx later), so the httpOnly refresh cookie is scoped to /api/auth.
REFRESH_COOKIE_PATH=/api/auth
